<h2>エンドユーザープロフィール</h2>

<h4>プロフィール画像</h4>
<p><%= image_tag @user.get_profile_image(150, 150) %></p>

<h4>ユーザーネーム</h4>
<p><%= @user.name %></p>

<h4>都道府県</h4>
<p><%= @user.prefecture %></p>

<h4>誕生年</h4>
<p><%= @user.birth_year %></p>

<h4>自己紹介</h4>
<p><%= @user.introduction %></p>

<h4>ステータス</h4>
<p>
  <% if @user.is_forbidden == true %>
    除名済み
  <% elsif @user.is_active == false %>
    退会済み
  <% else %>
    有効
  <% end %>
</p>

<h4>登録日時</h4>
<p><%= @user.created_at.strftime('%Y/%m/%d %H:%M') %></p>

<h4>プロフィール更新日時</h4>
<p><%= @user.updated_at.strftime('%Y/%m/%d %H:%M') %></p>

<h2>管理メニュー</h2>
<% if @user.guest_user? %>
  ゲストモードに支障が出ないようにするため、操作不可とします。
<% else %>
    <!--
      <%= link_to 'プロフィールを編集する', edit_admin_user_path(@user) %>
      不適切な画像・テキストなどがある場合に使用
    -->
    <p>
      <% if @user.is_active == true %>
        <%= link_to '退会させる', admin_users_toggle_activity_path(@user), method: :patch, "data-confirm" => '本当に退会させますか？', class: "btn btn-warning btn-sm" %><br />
        退会操作を自分でできないユーザーを退会させるときに使用<br />迷惑ユーザーの除名とは異なります
      <% elsif @user.is_forbidden == false %>
        <%= link_to '退会を取り消す', admin_users_toggle_activity_path(@user), method: :patch, "data-confirm" => '本当に退会を取り消しますか？', class: "btn btn-primary btn-sm" %><br />
        誤って退会したユーザーを復帰させるときに使用<br />除名したユーザーは復帰させられません
      <% else %>
        <span class="text-danger">退会の取り消し不可</span><br />
        除名したユーザーは復帰させられません
      <% end %>
    </p>
    <p>
      <% if @user.is_forbidden == false %>
        <%= link_to '除名する', admin_users_banish_path(@user), method: :patch, "data-confirm" => '※※全投稿・コメントが削除されます！！※※本当に除名しますか？', class: "btn btn-danger btn-sm" %>
      <% else %>
      <span class="text-danger">除名済み</span>
      <% end %>
      <br />
      迷惑ユーザーを除名する場合に使用<br />
      <span class="text-danger">除名すると投稿・コメントが全て削除されます。慎重に行ってください</span>
    </p>
    <p>
      <% if @user.is_forbidden == false %>
        <%= link_to '全投稿を管理者非公開にする', admin_user_hide_posts_path, method: :patch, "data-confirm" => '一括で元に戻すことは出来ません。本当に全ての投稿を非公開にしますか？', class: "btn btn-warning btn-sm" %><br />
        全ての投稿を管理者非公開にします。コメントは対象外です
      <% else %>
        全投稿を管理者非公開にする<br />
        除名済みユーザーのため投稿データがありません
      <% end %>
    </p>
    <p>
      <% if @user.is_forbidden == false %>
        <%= link_to '全投稿・コメントを削除する', admin_user_delete_posts_path, method: :patch, "data-confirm" => '※※全投稿・コメントが削除されます！！※※本当に実行しますか？', class: "btn btn-danger btn-sm" %><br />
        全ての投稿・コメントを削除します<br />退会を代行した際に削除を希望された場合に使用。除名の際は操作不要です
      <% else %>
        全投稿・コメントを削除する<br />
        除名済みユーザーのため投稿データがありません
      <% end %>
    </p>

  <!--
    <h4><%= @user.name %>の投稿一覧</h4>

    <h4><%= @user.name %>のコメント一覧</h4>
  -->
<% end %>
