<h2>エンドユーザープロフィール</h2>

<div class="mb-3">
  <label class="h5 d-block">
    <%= attribute_name(User, :profile_image) %>
  </label>
  <%= image_tag @user.get_profile_image(150, 150) %>
</div>

<div class="mb-3">
  <label class="h5 d-block">
    <%= attribute_name(User, :name) %>
  </label>
  <%= @user.name %>
</div>

<div class="mb-3">
  <label class="h5 d-block">
    <%= attribute_name(User, :prefecture) %>
  </label>
  <%= @user.prefecture %>
</div>

<div class="mb-3">
  <label class="h5 d-block">
    <%= attribute_name(User, :birth_year) %>
  </label>
  <%= @user.birth_year %>
</div>

<div class="mb-3">
  <label class="h5 d-block">
    <%= attribute_name(User, :introduction) %>
  </label>
  <%= @user.introduction %>
</div>

<h4>ステータス</h4>
<p>
  <% if @user.is_forbidden %>
    除名済み
  <% elsif !@user.is_active %>
    退会済み
  <% else %>
    有効
  <% end %>
</p>

<h4>登録日時</h4>
<p><%= @user.created_at.strftime('%Y/%m/%d %H:%M') %></p>

<h4>プロフィール更新日時</h4>
<p><%= @user.updated_at.strftime('%Y/%m/%d %H:%M') %></p>

<p>
  <%= link_to "#{@user.name}の投稿一覧", admin_user_posts_path(@user), class: "btn btn-primary" %>
</p>

<h2>管理メニュー</h2>
<% if @user.guest_user? %>
  ゲストモードに支障が出ないようにするため、操作不可とします。
<% else %>
    <!--
      <%= link_to 'プロフィールを編集する', edit_admin_user_path(@user) %>
      不適切な画像・テキストなどがある場合に使用
    -->
    <p>
      <% if @user.is_active %>
        <%= link_to '退会させる', admin_users_deactivate_path, method: :patch, "data-confirm" => '本当に退会させますか？', class: "btn btn-warning btn-sm" %><br />
        退会操作を自分でできないユーザーを退会させるときに使用<br />
        迷惑ユーザーの除名とは異なります<br />
        いいね・報告・フォロー関係のデータが全て削除されます<br />
        投稿とコメントは削除されません<br />
        削除を希望の場合は「全投稿・コメントを削除する」を実行してください
      <% elsif !@user.is_forbidden %>
        <%= link_to '退会を取り消す', admin_users_activate_path, method: :patch, "data-confirm" => '本当に退会を取り消しますか？', class: "btn btn-primary btn-sm" %><br />
        誤って退会したユーザーを復帰させるときに使用<br />除名したユーザーは復帰させられません
      <% else %>
        <span class="text-danger">退会の取り消し不可</span><br />
        除名したユーザーは復帰させられません
      <% end %>
    </p>
    <p>
      <% if !@user.is_forbidden %>
        <%= link_to '除名する', admin_users_banish_path(@user), method: :patch, "data-confirm" => '※※全投稿・コメントが削除されます！！※※本当に除名しますか？', class: "btn btn-danger btn-sm" %>
      <% else %>
      <span class="text-danger">除名済み</span>
      <% end %>
      <br />
      迷惑ユーザーを除名する場合に使用<br />
      <span class="text-danger">除名するといいね・報告・フォロー関連・投稿・コメントが全て削除されます<br />慎重に行ってください</span>
    </p>
    <p>
      <% if !@user.is_forbidden %>
        <%= link_to '全投稿を管理者非公開にする', admin_user_hide_posts_path, method: :patch, "data-confirm" => '一括で元に戻すことは出来ません。本当に全ての投稿を非公開にしますか？', class: "btn btn-warning btn-sm" %><br />
        全ての投稿を管理者非公開にします。コメントは対象外です
      <% else %>
        全投稿を管理者非公開にする<br />
        除名済みユーザーのため投稿データがありません
      <% end %>
    </p>
    <p>
      <% if !@user.is_forbidden %>
        <%= link_to '全投稿・コメントを削除する', admin_user_delete_posts_path, method: :patch, "data-confirm" => '※※全投稿・コメントが削除されます！！※※本当に実行しますか？', class: "btn btn-danger btn-sm" %><br />
        全ての投稿・コメントを削除します<br />退会を代行した際に削除を希望された場合に使用。除名の際は操作不要です
      <% else %>
        全投稿・コメントを削除する<br />
        除名済みユーザーのため投稿データがありません
      <% end %>
    </p>

  <!--
    <h4><%= @user.name %>の投稿一覧</h4>

    <h4><%= @user.name %>のコメント一覧</h4>
  -->
<% end %>
