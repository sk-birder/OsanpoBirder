<% if current_user.guest_user? %>
  <i class="fa-regular fa-heart"></i>  <%= post.likes.count %>
<% elsif post.liked_by?(current_user) %>
  <%= link_to post_like_path(post), method: :delete, remote: true do %>
    <i class="fa-solid fa-heart"></i>  <%= post.likes.count %>
  <% end %>
<% else %>
  <%= link_to post_like_path(post), method: :post, remote: true do %>
    <i class="fa-regular fa-heart"></i>  <%= post.likes.count %>
  <% end %>
<% end %>
