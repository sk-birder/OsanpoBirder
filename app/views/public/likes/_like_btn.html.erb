<% if current_user.guest_user? %>
  <i class="fa-regular fa-heart"></i> いいね ( <%= count_likes %> )
<% elsif post.liked_by?(current_user) %>
  <%= link_to post_like_path(post), method: :delete, remote: true do %> <!-- remote: trueを追加 -->
    <i class="fa-solid fa-heart"></i> いいね ( <%= count_likes %> )
  <% end %>
<% else %>
  <%= link_to post_like_path(post), method: :post, remote: true do %> <!-- remote: trueを追加 -->
    <i class="fa-regular fa-heart"></i> いいね ( <%= count_likes %> )
  <% end %>
<% end %>
