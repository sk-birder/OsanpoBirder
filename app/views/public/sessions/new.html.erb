<h2>会員ログイン</h2>

<%= form_with model: @user, url: user_session_path do |f| %>
  <div class="mb-3">
    <%= f.label :email, class: "h5 d-block" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="mb-3">
    <%= f.label :password, class: "h5 d-block" %>
    <%= f.password_field :password, autocomplete: "current-password" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="mb-3">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me %>
    </div>
  <% end %>

  <div>
    <%= f.submit "ログイン", class: "btn btn-success px-3 py-2" %>
  </div>
<% end %>

<%# render "public/shared/links" %>
<p class="my-3"><%= link_to '管理者ログイン', new_admin_session_path %></p>