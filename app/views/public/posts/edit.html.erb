<h2>投稿編集</h2>

<% if @post.errors.any? %>
  <p><%= @post.errors.count %>件のエラーが発生しました。</p>
  <ul>
    <% @post.errors.full_messages.each do |m| %>
      <li><%= m %></li>
    <% end %>
  </ul>
<% end %>

<%= render '/public/attention' %>

<h4>スポット選択</h4>
<div id="map" class="w-100 mb-2" style="height: calc(50vh);"></div>

<%= form_with model: @post, url: post_path, method: :patch do |f| %>
  <%= f.hidden_field :latitude,  id: "lat" %>
  <%= f.hidden_field :longitude, id: "lng" %>
  <%= javascript_pack_tag 'map_posts_edit', 'data-turbolinks-track': 'reload' %>

  <h4>写真</h4>
  <p>
    <%= f.file_field :post_images, accept: "image/*",  multiple: true %>
  </p>

  <h4>タイトル(100文字まで)</h4>
  <p>
    <%= f.text_field :title, autofocus: true, class: "post-title-form" %>
  </p>
  
  <h4>カテゴリ</h4>
  <%# Categoryモデルからデータを呼び出しセレクトボックスに表示 %>
  <p>
    <%= f.collection_select(:category_id, Category.all, :id, :name) %>
  </p>

  <h4>都道府県</h4>
  <p>
    ※ 自動入力されますが、誤っている場合は訂正できます。海上や日本以外の場所を選択すると表示されません。<br />
    <%= f.select :prefecture, Post.prefectures.keys, {}  %>
  </p>

  <h4>月</h4>
  <p>
    <%= f.select :month, Post.months.keys, {} %>
  </p>
  
  <h4>本文(1000文字まで)</h4>
  <p>
    <%= f.text_area :body, rows: '10', class: "post-body-form" %>
  </p>

  <h4>公開・非公開</h4>
  <p>
    <% if @post.is_forbidden %>
      <p class="text-danger">管理者による非公開状態のため、公開を選択しても公開されません。</p>
    <% end %>
    <%= f.radio_button(:is_public, true, checked: true) %>
    <%= f.label(:is_public, '公開', value: true) %>
    <%= f.radio_button(:is_public, false) %>
    <%= f.label(:is_public, '非公開', value: false) %>
  </p>

  <%= f.submit '更新する', class: "btn btn-success px-3 py-2" %>
<% end %>
