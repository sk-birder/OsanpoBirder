<h2>投稿詳細</h2>

<% if @post.is_public == false && @post.user_id != current_user.id %>
  <p>この投稿は非公開です。</p>
<% elsif @post.is_forbidden && @post.user_id != current_user.id %>
  <p>この投稿は非公開です。</p>
<% else %>
  <h4>スポット</h4>
  <div id="map" class="w-100 mb-2" style="height: calc(50vh);"></div>

  <div>
    <!-- JSに座標を渡すための記述 valueの設定は%=でないと機能しない -->
    <input type="hidden" id="lat" value="<%= @post.latitude %>">
    <input type="hidden" id="lng" value="<%= @post.longitude %>">
    <!-- JS呼び出し 座標を渡すためここに記述 -->
    <%= javascript_pack_tag 'map_posts_show', 'data-turbolinks-track': 'reload' %>

    <h4>写真</h4>
    <p>
      <% if @post.post_images.attached? %>
        <% @post.post_images.each do |post_image| %>
          <%= image_tag post_image.variant(resize_to_limit: [1000, 1000]).processed, class: "post-image" %>
        <% end %>
      <% else %>
        画像なし
      <% end  %>
    </p>
    <h4>タイトル</h4>
    <p>
      <%= @post.title %>
    </p>
    <h4>カテゴリ</h4>
    <p>
      <%= @categories.find(@post.category_id).name %>
    </p>
    <h4>都道府県</h4>
    <p>
      <%= @post.prefecture %>
    </p>
    <h4>月</h4>
    <p>
      <%= @post.month %>
    </p>
    <h4>本文</h4>
    <p>
      <%= @post.body %>
    </p>
    <h4>投稿ユーザー</h4>
    <p>
      <%= link_to user_path(@post.user_id) do %>
        <%= image_tag @post.user.get_profile_image(150, 150) %><br />
        <%= @post.user.name %>
      <% end %>
    </p>
    <h4>いいね・報告</h4>
    <p id="like_btn"> <%# Javascriptのセレクタ用にidを設定する。部分テンプレートにブロック要素を入れる場合はpではなくdivを使用すること %>
      <%= render '/public/likes/like_btn', post: @post, count_likes: @count_likes %>
    </p>
    <p id="report_btn">
      <%= render '/public/reports/report_btn', post: @post, count_report0: @count_report0, count_report1: @count_report1, count_report2: @count_report2, report: @report %>
    </p>
  </div>

  <!-- 投稿ユーザ本人のみ表示 公開状態・編集・削除 -->
  <% if @post.user_id == current_user.id %>
    <h4>公開ステータス</h4>
    <p>
      <% if @post.is_forbidden %>
        <span style="color: red">管理者による非公開</span>
      <% elsif @post.is_public == false %>
        非公開
      <% else %>
        公開
      <% end %>
    </p>
    <p>
      <%= link_to '編集する', edit_post_path, class:"btn btn-info px-3 py-2 mr-2" %>
      <%= link_to '削除する', post_path, method: :delete, "data-confirm" => "本当に削除しますか？", class: "btn btn-danger px-3 py-2" %>
    </p>
  <% end %>

  <% if current_user.guest_user? == false %>
    <h4>コメントフォーム</h4>
    <%= form_with model: @new_user_comment, url: post_comments_path(@post), method: :post, local: true do |f| %>
      <%= f.text_area :body, rows: 3, placeholder: "最大1000文字", rows: '3', class: "comment-form" %> <br />
      <%= f.submit 'コメントする', class: "btn btn-success px-3 py-2" %>
    <% end %>
  <% end %>

  <h4>コメント一覧</h4>
  <% if @comments.count == 0 %>
    <p>この投稿にはまだコメントがありません。</p>
  <% else %>
    <% @comments.each do |comment| %>
      <div class="row mx-auto mb-3">
        <div class="mx-3">
          <%= link_to user_path(comment.user_id) do %>
            <%= image_tag comment.user.get_profile_image(50, 50) %>
          <% end %>
        </div>
        <div>
          <%= comment.body %><br />
          <%= comment.created_at.strftime('%Y/%m/%d') %><br />
          <%= link_to user_path(comment.user_id) do %>
            <%= comment.user.name %>
          <% end %><br />
          <% if comment.user_id == current_user.id %>
            <%= link_to '削除する', post_comment_path(comment.post_id, comment.id), method: :delete, "data-confirm" => "本当に削除しますか？", class: "btn btn-danger btn-sm" %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

<% end %>
