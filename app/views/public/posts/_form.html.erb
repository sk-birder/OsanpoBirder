<button data-toggle="collapse" href="#attention" class="btn btn-primary my-2">投稿時の注意事項（クリックで表示切替）</button>
<div id="attention" class="p-2 m-2 bg-light border border-success rounded collapse">
  <h5>野鳥や野生動物の情報共有は時間をおいて行いましょう</h5>
  <p>
    リアルタイムな共有はやめましょう。<br />
    珍しい野鳥や動物の情報共有は、対象がいなくなってから行ってください。
  </p>
  <h5>営巣中や育雛中の情報共有はやめましょう</h5>
  <p>
    巣のそばに近寄ること自体が親鳥にとってストレスとなります。<br />
    見かけたらすぐにその場を離れましょう。<br />
    そして、情報共有は行わないようにしましょう。
  </p>
  <h5>参考資料</h5>
  <a href="https://www.wbsj.org/activity/press-releases/press-2022-04-26/" target="_blank" rel="noopener noreferrer">プレスリリース：野鳥観察・撮影の初心者の方に向けた、マナーのガイドラインを策定(日本野鳥の会)</a>
</div>

<h5>スポット選択</h5>
<div id="map" class="w-100 mb-2" style="height: calc(50vh);"></div>

<%= form_with model: post do |f| %>
  <%= f.hidden_field :latitude,  id: "lat" %>
  <%= f.hidden_field :longitude, id: "lng" %>

  <div class="mb-3">
    <%= f.label :post_images, class: "h5 d-block" %>
    <%= f.file_field :post_images, accept: "image/*",  multiple: true %>
  </div>

  <div class="mb-3">
    <%= f.label :title, class: "h5 d-block" %>
    <small class="d-block mb-2">(100文字以下)</small>
    <%= f.text_field :title, autofocus: true, class: "post-title-form" %>
  </div>
  
  <div class="mb-3">
    <%= f.label :category_id, class: "h5 d-block" %>
    <%# Categoryモデルからデータを呼び出しセレクトボックスに表示 %>
    <%= f.collection_select(:category_id, categories, :id, :name) %>
  </div>

  <div class="mb-3">
    <%= f.label :prefecture, class: "h5 d-block" %>
    <small class="d-block mb-2 text-muted">※ 自動入力されますが、誤っている場合は訂正できます。海上や日本以外の場所を選択すると表示されません。</small>
    <%= f.select :prefecture, Post.prefectures.keys, {selected: current_user.prefecture}, id: "post_prefecture"  %>
  </div>

  <div class="mb-3">
    <%= f.label :month, class: "h5 d-block" %>
    <%= f.select :month, Post.months.keys, {} %>
  </div>
  
  <div class="mb-3">
    <%= f.label :body, class: "h5 d-block" %>
    <small class="d-block mb-2">(1000文字以下)</small>
    <%= f.text_area :body, rows: 10, class: "post-body-form" %>
  </div>

  <div class="mb-3">
    <%= f.label :is_public, class: "h5 d-block" %>
    <% if post.is_forbidden %>
      <p class="text-danger">管理者による非公開状態のため、公開を選択しても公開されません。</p>
    <% end %>
    <%= f.radio_button(:is_public, true, checked: true) %>
    <%= f.label(:is_public, '公開', value: true) %>
    <%= f.radio_button(:is_public, false) %>
    <%= f.label(:is_public, '下書き', value: false) %>
  </div>

  <%= f.submit '投稿する', class: "btn btn-success px-3 py-2" %>
<% end %>
