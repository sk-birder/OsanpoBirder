<h2>公開投稿一覧</h2>
<div>
  <button class="btn btn-outline-primary btn-sm"><%= link_to '新しい順', posts_path, remote: true %></button>
  <button class="btn btn-outline-primary btn-sm"><%= link_to '古い順', posts_path(sort: 'old'), remote: true %></button>
</div>
<%# render '/posts_sort_buttons', list_type: @list_type %>
<div id="posts">
  <%= render '/public/posts', posts: @posts %>
</div>
