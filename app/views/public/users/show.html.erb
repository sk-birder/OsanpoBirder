<% if @user.is_forbidden %>
  <h4>このユーザーのプロフィールは表示できません。</h4>
<% else %>
  <h2><%= @user.name %>のプロフィール</h2>

  <% if !@user.is_active %>
    <p class="text-danger">
      退会済みユーザー
    </p>
  <% end %>
  <p><%= image_tag @user.get_profile_image(150, 150) %></p>

  <h4>都道府県</h4>
  <p>
    <% if @user.hide_prefecture %>
      <span class="m-1 p-1  rounded bg-info text-white-50">非公開</span>
    <% else %>
      <span class="m-1 p-1  rounded bg-info text-white"><%= @user.prefecture %></span>
    <% end %>
  </p>

  <h4>誕生年</h4>
  <p>
    <% if @user.hide_birth_year %>
      <span class="m-1 p-1  rounded bg-success text-white-50">非公開</span>
    <% else %>
      <span class="m-1 p-1  rounded bg-success text-white"><%= @user.birth_year %>年</span>
    <% end %>
  </p>

  <h4>自己紹介</h4>
  <p><%= @user.introduction %></p>

  <p>
    <%= link_to user_following_path(@user) do %>
      <%= @user.following_relationships.count %> フォロー
    <% end %>
    / 
    <%= link_to user_followers_path(@user) do %>
      <%= @user.follower_relationships.count %> フォロワー
    <% end %>
  </p>
  <p id="relationship_btn">
    <%= render '/public/relationships/relationship_btn_at_users_show', user: @user %>
  </p>

  <% if @user.id == current_user.id && !@user.guest_user? %>
    <%= link_to 'プロフィール編集', edit_user_path(@user.id), class: "btn btn-success btn-sm mb-3" %>
  <% end %>

  <h4><%= @user.name %>の公開投稿（<%= @user.posts.visible.count %>件）</h4>
  <div>
    <button class="btn btn-outline-primary btn-sm"><%= link_to '新しい順', user_path(@user) %></button>
    <button class="btn btn-outline-primary btn-sm"><%= link_to '古い順', user_path(@user, posts_sort: 'old') %></button>
  </div>
  <%= render '/public/posts', posts: @posts %>
<% end %>