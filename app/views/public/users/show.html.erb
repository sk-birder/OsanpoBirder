<h2>ユーザープロフィール</h2>

<% if @user.is_forbidden %>
  このユーザーのプロフィールは表示できません。
<% else %>
  <h4>プロフィール画像</h4>
  <p><%= image_tag @user.get_profile_image(150, 150) %></p>

  <h4>ユーザーネーム</h4>
  <p><%= @user.name %></p>
  <p class="text-danger">
    <% if !@user.is_active %>
      退会済みユーザー
    <% end %>
  </p>

  <h4>都道府県</h4>
  <p>
    <% if @user.hide_prefecture %>
      非公開
    <% else %>
      <%= @user.prefecture %>
    <% end %>
  </p>

  <h4>誕生年</h4>
  <p>
    <% if @user.hide_birth_year %>
      非公開
    <% else %>
      <%= @user.birth_year %>年
    <% end %>
  </p>

  <h4>自己紹介</h4>
  <p><%= @user.introduction %></p>

  <p>
    <%= link_to user_following_path(@user) do %>
      <!-- @user.followersで取得できるのはfollower_user_idが@user.idのもの。フォロー中の数を表示するために呼び出す -->
      <%= @user.followers.count %> フォロー
    <% end %>
    / 
    <%= link_to user_followers_path(@user) do %>
      <!-- @user.followedsで取得できるのはfollowed_user_idが@user.idのもの。フォロワーの数を表示するために呼び出す -->
      <%= @user.followeds.count %> フォロワー
    <% end %>
  </p>
  <p id="relationship_btn">
    <%= render '/public/relationships/relationship_btn_at_users_show', user: @user %>
  </p>

  <% if @user.id == current_user.id && !@user.guest_user? %>
    <%= link_to 'プロフィール編集', edit_user_path(@user.id), class: "btn btn-success btn-sm mb-3" %>
  <% end %>

  <h4><%= @user.name %>の公開投稿</h4>
  <%= render '/public/posts', posts: @posts %>
<% end %>