<h2>マイページ</h2>

<div>
  <h4>プロフィール画像</h4>
  <p>
    <%= image_tag current_user.get_profile_image(150, 150) %>
  </p>

  <h4>メールアドレス</h4>
  <p>
    <%= current_user.email %>
  </p>

  <h4>ユーザーネーム</h4>
  <p>
    <%= current_user.name %>
  </p>

  <h4>都道府県</h4>
  <p>
    <%= current_user.prefecture %>
    <% if current_user.hide_prefecture %>
      （非公開）
    <% else %>
      （公開）
    <% end %>
  </p>

  <h4>誕生年</h4>
  <p>
    <%= current_user.birth_year %>
    <% if current_user.hide_birth_year %>
      （非公開）
    <% else %>
      （公開）
    <% end %>
  </p>

  <h4>自己紹介</h4>
  <p><%= current_user.introduction %></p>

  <p>
    <%= link_to 'プロフィールの編集', edit_user_path(current_user), class: "btn btn-success btn-sm mb-3" %><br />
    <%= link_to 'プロフィールページの確認', user_path(current_user), class: "btn btn-info btn-sm" %>
  </p>

  <% if !current_user.guest_user? %>
    <p>
      <%= link_to user_following_path(current_user) do %>
        <%# current_user.followersで取得できるのはfollower_user_idがcurrent_user.idのもの。フォロー中の数を表示するために呼び出す %>
        <%= current_user.followers.count %> フォロー中
      <% end %>
      / 
      <%= link_to user_followers_path(current_user) do %>
        <%# current_user.followedsで取得できるのはfollowed_user_idがcurrent_user.idのもの。フォロワーの数を表示するために呼び出す %>
        <%= current_user.followeds.count %> フォロワー
      <% end %>
    </p>
  <% end %>
</div>

<div class="mb-3">
  <h4>下書き一覧</h4>
  <% if @drafts_count > 0 %>
    <%= render '/public/users/mypage_posts', posts: @drafts %>
  <% else %>
    下書きがありません。
  <% end %>
</div>

<% if @forbidden_posts_count > 0 %>
  <div class="mb-3">
    <h4>管理者による非公開状態の投稿一覧</h4>
    <%= render '/public/users/mypage_posts', posts: @forbidden_posts %>
  </div>
<% end %>