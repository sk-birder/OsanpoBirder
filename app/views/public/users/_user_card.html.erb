<div class="card mt-3 shadow">
  <div class="d-flex flex-row">
    <div class="mr-2">
      <%= link_to user_path(user) do %>
        <%= image_tag user.get_profile_image(50, 50), class: "m-2" %>
      <% end %>
    </div>
    <div class="flex-grow-1">
      <div class="d-flex flex-row my-2 mr-2">
        <h4>
          <%= link_to user_path(user) do %>
            <%= user.name %>
          <% end %>
        </h4>
        <% if !current_user.guest_user? && user != current_user %>
          <span id="relationship_btn_<%= user.id %>" class="ml-auto">
            <%= render '/public/relationships/relationship_btn', user: user %>
          </span>
        <% end %>
      </div>
      <div class="mb-2">
        <% prefecture_data = prefecture_display_data(user) %>
        <span class="m-1 p-1 rounded bg-info <%= prefecture_data[:css] %>"><%= prefecture_data[:text] %></span>
        <% birth_year_data = birth_year_display_data(user) %>
        <span class="m-1 p-1 rounded bg-success <%= birth_year_data[:css] %>"><%= birth_year_data[:text] %></span>
      </div>
      <div class="mb-2">
        <%= user.introduction %>
      </div>
      <div class="mb-2">
        <%= user.posts.visible.count %> ポスト / <%= user.following_relationships.count %> フォロー / <%= user.follower_relationships.count %> フォロワー
      </div>
    </div>
  </div>
</div>
