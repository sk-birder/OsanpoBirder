<div class="card mt-3 shadow">
  <div class="d-flex flex-column">
    <div class="d-flex flex-row justify-content-between">
      <div>
        <%= image_tag user.get_profile_image(150, 150), class: "m-2" %>
      </div>
    
      <div class="d-flex align-items-end">
        <% if user == current_user %>
          <%= link_to 'プロフィール編集', edit_user_path(current_user), class: "btn btn-outline-primary btn-sm m-2" %>
        <% elsif !user.guest_user? %>
          <span id="relationship_btn_<%= user.id %>" class="m-2">
            <%= render '/public/relationships/relationship_btn', user: user %>
          </span>
        <%# else  ゲストモード時はボタン非表示 %>
        <% end %>
      </div>
    </div>

    <div>
      <h4 class="ml-2 mb-2">
        <%= user.name %>
      </h4>
      <% if !@user.is_active %>
        <div class="ml-2 mb-2 text-danger">
          退会済みユーザー
        </div>
      <% end %>
      <div class="ml-2 mb-2">
        <%= user.introduction %>
      </div>
      <div class="ml-2 mb-2">
        <%# 何か気持ち悪い構造になっているのでCSSの部分を含めてhelperに逃がせないか検討 %>
        <% if user.hide_prefecture %>
          <span class="mr-2 p-1  rounded bg-info text-white-50"><%= hidden_prefecture_display(user) %></span>
        <% else %>
          <span class="mr-2 p-1  rounded bg-info text-white"><%= user.prefecture %></span>
        <% end %>
        <% if user.hide_birth_year %>
          <span class="p-1  rounded bg-success text-white-50">誕生年非公開</span>
        <% else %>
          <span class="p-1  rounded bg-success text-white"><%= user.birth_year %>年</span>
        <% end %>
      </div>
      <div class="ml-2 mb-2">
        <%= user.posts.visible.count %> ポスト / 
        <%= link_to user_following_path(@user) do %>
          <%= user.following_relationships.count %> フォロー 
        <% end %>
        /
        <%= link_to user_followers_path(@user) do %>
          <%= user.follower_relationships.count %> フォロワー
        <% end %>
      </div>
    </div>
  </div>
</div>
