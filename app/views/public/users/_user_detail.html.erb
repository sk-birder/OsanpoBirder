<div class="card mt-3 shadow">
  <div class="d-flex flex-column">
    <div class="d-flex flex-row justify-content-between">
      <div>
        <%= image_tag user.get_profile_image(150, 150), class: "m-2" %>
      </div>
    
      <div class="d-flex align-items-end">
        <% if user == current_user %>
          <%= link_to 'プロフィール編集', edit_user_path(current_user), class: "btn btn-outline-primary btn-sm m-2" %>
        <% elsif !user.guest_user? %>
          <span id="relationship_btn_<%= user.id %>" class="m-2">
            <%= render '/public/relationships/relationship_btn', user: user %>
          </span>
        <%# else  ゲストモード時はボタン非表示 %>
        <% end %>
      </div>
    </div>

    <div>
      <div class="d-flex flex-row my-2 mr-2">
        <h4>
          <%= user.name %>
        </h4>
      </div>
      <div class="mb-2">
        <% if user.hide_prefecture %>
          <span class="m-1 p-1  rounded bg-info text-white-50">非公開</span>
        <% else %>
          <span class="m-1 p-1  rounded bg-info text-white"><%= user.prefecture %></span>
        <% end %>
        <% if user.hide_birth_year %>
          <span class="m-1 p-1  rounded bg-success text-white-50">非公開</span>
        <% else %>
          <span class="m-1 p-1  rounded bg-success text-white"><%= user.birth_year %>年</span>
        <% end %>
      </div>
      <div class="mb-2">
        <%= user.introduction %>
      </div>
      <div class="mb-2">
        <%= user.posts.visible.count %> ポスト / <%= user.following_relationships.count %> フォロー / <%= user.follower_relationships.count %> フォロワー
      </div>
    </div>
  </div>
</div>
