<div class="card-list-container">
  <% posts.each do |post| %>
    <div class="card mt-3 shadow">
      <div class="d-flex flex-column">
        <div class="p-2">
          <% if post.post_images.attached? %>
            <%= image_tag post.show_first_post_image(50, 50) %>
          <% else %>
            なし
          <% end %>
        </div>
        <div class="p-2">
          <%= link_to post_path(post.id) do %>
            <%= post.title %>
          <% end %>
        </div>
        <div class="row justify-content-around p-2">
          <span><%= Category.find(post.category_id).name %></span>
          <span><%= post.prefecture %></span>
          <span><%= post.month %></span>
        </div>
        <div class="row p-2">
          <div class="col-8">
            <%= link_to user_path(post.user_id) do %>
              <%= image_tag post.user.get_profile_image(50, 50) %>
              <span class="ml-2"><%= post.user.name %></span>
            <% end %>
          </div>
          <div class="col-4">
            <div class="text-center"><%= post.updated_at.strftime('%Y/%m/%d') %></div>
            <div class="text-center">
              <span>
                <i class="fa-regular fa-comment"></i> <%= post.post_comments.count %>
              </span>
              <span>
                <% if current_user.guest_user? %>
                  <i class="fa-regular fa-heart"></i>  <%= post.likes.count %>
                <% elsif post.liked_by?(current_user) %>
                  <%= link_to post_like_path(post), method: :delete do %>
                  <i class="fa-solid fa-heart"></i>  <%= post.likes.count %>
                  <% end %>
                <% else %>
                  <%= link_to post_like_path(post), method: :post do %>
                    <i class="fa-regular fa-heart"></i>  <%= post.likes.count %>
                  <% end %>
                <% end %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

