<% if !user.is_active %>
  <button class="btn btn-outline-secondary">退会済み</button>
<% elsif user.followeds.exists?(follower_user_id: current_user.id) %>
  <%= button_to 'フォロー解除', user_relationships_path(user, from_page: 'users_list'), method: :delete, remote: true, class: "btn btn-outline-danger" %>
<% else %>
  <%= button_to 'フォローする', user_relationships_path(user, from_page: 'users_list'), method: :post, remote: true, class: "btn btn-outline-primary" %>
<% end %>
