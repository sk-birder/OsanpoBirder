<div class="d-flex flex-column align-items-center">
  <%= image_tag 'logo.png', class: "my-5", style: "max-width: 90%" %>
  
  <%= link_to 'サイト紹介', about_path, class:"top-button btn btn-info btn-lg mb-5" %>
  <% if user_signed_in? %>
    <%= link_to 'ログアウト', destroy_user_session_path, method: :delete, class:"top-button btn btn-danger btn-lg mb-5" %>
  <% else %>
    <%= link_to 'ゲストモード', users_guest_sign_in_path, method: :post, class:"top-button btn btn-light btn-lg mb-5"  %>
    <%= link_to 'ログイン', new_user_session_path, class:"top-button btn btn-success btn-lg mb-5" %>
    <%= link_to 'アカウント作成', new_user_registration_path, class:"top-button btn btn-primary btn-lg mb-5" %>
  <% end %>
</div>