<!DOCTYPE html>
<html>
  <head>
    <title>お散歩BIRDER</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://kit.fontawesome.com/16d350bfe1.js" crossorigin="anonymous"></script>
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body class="d-flex flex-column vh-100">
    <header style="background-color: springgreen">
      <nav class="navbar navbar-expand-md navbar-light">
        <div class="container">
          <% if admin_signed_in? %>
            <div class="col-4">
              <%= link_to admin_root_path do %>
                <i class="fa-solid fa-dove"></i>お散歩BIRDER
              <% end %>
            </div>
            <div class="col-8 d-flex justify-content-between">
              <span>
                <%= link_to admin_posts_path do %>
                  <i class="fa-solid fa-newspaper"></i> 投稿一覧
                <% end %>
              </span>
              <span>
                <%= link_to admin_post_comments_path do %>
                  <i class="fa-solid fa-comments"></i> コメント一覧
                <% end %>
              </span>
              <span>
                <%= link_to admin_reports_path do %>
                  <i class="fa-solid fa-circle-exclamation"></i> 違反投稿一覧
                <% end %>
              </span>
              <span>
                <%= link_to admin_users_path(status: 'active') do %>
                  <i class="fa-solid fa-users"></i> ユーザーー覧
                <% end %>
              </span>
              <!--
                <span>
                <i class="fa-solid fa-list-ul"></i> 管理者掲示板
                </span>
                <span>
                  <i class="fa-solid fa-map-location-dot"></i> 地図
                </span>
              -->
              <span>
                <%= link_to destroy_admin_session_path, method: :delete do %>
                  <i class="fa-solid fa-arrow-right-from-bracket"></i> Log out
                <% end %>
              </span>
            </div>

          <% elsif user_signed_in? %>
            <%= link_to root_path, class:"navbar-brand p-2" do %>
              <i class="fa-solid fa-dove"></i> お散歩BIRDER
            <% end %>
            <button class="ml-auto navbar-toggler" type="button" data-toggle="collapse" data-target="#endUserMenu">
              <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse row" id="endUserMenu">
              <ul class="mx-auto d-block d-md-none" style="list-style: none">
                <% if current_user.guest_user? == false %>
                  <li class="mb-2">
                    <%= link_to timeline_path, class: "navbar-link" do %>
                      <i class="fa-solid fa-timeline mr-2"></i>タイムライン
                    <% end %>
                  </li>
                  <li class="mb-2">
                    <%= link_to mypage_path, class: "navbar-link" do %>
                      <i class="fa-solid fa-circle-user mr-2"></i>マイページ
                    <% end %>
                  </li>
                  <li class="mb-2">
                    <%= link_to user_likes_path(current_user.id), class: "navbar-link" do %>
                      <i class="fa-solid fa-heart mr-2"></i>いいね一覧
                    <% end %>
                  </li>
                  <li class="mb-2">
                    <%= link_to new_post_path, class: "navbar-link" do %>
                      <i class="fa-solid fa-pen-fancy mr-2"></i>新規投稿
                    <% end %>
                  </li>
                <% end %>
                <li class="mb-2">
                  <%= link_to posts_path, class: "navbar-link" do %>
                    <i class="fa-solid fa-newspaper mr-2"></i>投稿一覧
                  <% end %>
                </li>
                <li class="mb-2">
                  <%= link_to map_path, class: "navbar-link" do %>
                    <i class="fa-solid fa-map-location-dot mr-2"></i>地図
                  <% end %>
                </li>
                <li class="mb-2">
                  <%= link_to users_path, class: "navbar-link" do %>
                    <i class="fa-solid fa-users mr-2"></i>ユーザーー覧
                  <% end %>
                </li>
                <li>
                  <%= link_to destroy_user_session_path, method: :delete, class: "navbar-link" do %>
                    <i class="fa-solid fa-arrow-right-from-bracket mr-2"></i>ログアウト
                  <% end %>
                </li>
              </ul>
            </div>

          <% else %>
            <div class="col-4">
              <%= link_to root_path  do %>
                <i class="fa-solid fa-dove"></i>お散歩BIRDER
              <% end %>
            </div>
            <div class="col-8 d-flex justify-content-between">
              <span>
                <%= link_to about_path do %>
                  <i class="fa-solid fa-circle-info"></i> About
                <% end %>
              </span>
              <span>
                <%= link_to users_guest_sign_in_path, method: :post do %>
                  <i class="fa-solid fa-clover"></i> Guest
                <% end %>
              </span>
              <span>
              <%= link_to new_user_registration_path do %>
                <i class="fa-solid fa-user-plus"></i> Sign up
              <% end %>
              </span>
              <span>
                <%= link_to new_user_session_path do %>
                  <i class="fa-solid fa-arrow-right-to-bracket"></i> Log in
                <% end %>
              </span>
            </div>
          <% end %>
        </div>
      </nav>
    </header>

    <div class="my-2 d-flex justify-content-center">
      <%= render 'public/searches/search_form' %>
    </div>

    <p>
      <%= flash[:notice] %>
      <%= alert %>
    </p>

    <main class="mb-auto">
      <div class="container">
        <div class="row">
          <div class="col-md-3 d-none d-md-block">
            <nav class="navbar">
              <% if admin_signed_in? %>
                <%= render '/admin/sidebar' %>
              <% else %>
                <%= render '/public/sidebar' %>
              <% end %>
            </nav>
          </div>
          <div class="col-12 col-md-9 mb-3">
            <%= yield %>
          </div>
        </div>
      </div>
    </main>

    <footer class="d-flex p-3" style="background-color: darkolivegreen">
      <div class="col-4" style="color: white">
        <% if admin_signed_in? %>
          <i class="fa-solid fa-user-tie"></i>お散歩BIRDER
        <% elsif user_signed_in? %>
          <% if current_user.guest_user? %>
            <i class="fa-solid fa-egg"></i>お散歩BIRDER
          <% else %>
            <i class="fa-solid fa-crow"></i>お散歩BIRDER
          <% end %>
        <% else %>
          お散歩BIRDER
        <% end %>
      </div>
      <div class="col-8 d-flex justify-content-end" style="color: white">
        <span>散歩や自然観察を愛する人のためのSNS</span>
      </div>
    </footer>
  </body>
</html>
